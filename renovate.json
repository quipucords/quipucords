{
  "prHourlyLimit": 20,
  "packageRules": [
    {
      "description": "Tekton pipelines and tasks",
      "matchManagers": ["tekton"],
      "groupName": "tekton",
      "schedule": ["* 5-23 * * 5"]
    },
    {
      "description": "GitHub Actions pipelines and tasks",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "schedule": ["* 5-23 * * 1-5"]
    },
    {
      "description": "Containerfile base image updates",
      "matchManagers": ["dockerfile"],
      "groupName": "containerfile",
      "schedule": ["* 5-23 * * 5"]
    },
    {
      "description": "Disable updates for languages - our dependency pipeline does not fit MintMaker model",
      "matchCategories": ["js", "python"],
      "enabled": false
    }
  ]
}
